<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="257.0" prefWidth="351.0" spacing="12.0" style="-fx-padding: 20;" styleClass="root dialog-content" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DeleteUserController">
        <Label fx:id="deleteTitle" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Delete Account" />
        <Label fx:id="deleteWarning" maxWidth="420.0" prefHeight="51.0" prefWidth="420.0" text="Are you sure you want to delete your account?&#10;This will permanently delete all your notebooks and notes!" textOverrun="CLIP" wrapText="true" />
        <Label fx:id="deleteConfirmLabel" text="Enter password to confirm:" />
        <PasswordField fx:id="passwordField" prefHeight="26.0" prefWidth="295.0" promptText="Password" />
        <Label fx:id="messageLabel" styleClass="message-label" visible="false" wrapText="true" />

        <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                    <HBox.margin>
                        <Insets top="8.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" style="-fx-text-fill: white;" styleClass="danger-button" text="Delete">
                    <HBox.margin>
                        <Insets top="8.0" />
                    </HBox.margin>
                </Button>
        </HBox>
</VBox>
