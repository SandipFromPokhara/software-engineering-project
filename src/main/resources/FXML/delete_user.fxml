<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" prefHeight="257.0" prefWidth="388.0" spacing="12.0" style="-fx-background-color: #f4f4f4; -fx-padding: 20;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DeleteUserController">
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Delete Account" />
        <Label maxWidth="420.0" prefHeight="51.0" prefWidth="420.0" text="Are you sure you want to delete your account?&#10;This will permanently delete all your notebooks and notes." textOverrun="CLIP" wrapText="true" />
        <Label text="Enter your password to confirm" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <Label fx:id="messageLabel" textFill="#d32f2f" visible="false" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                    <HBox.margin>
                        <Insets top="8.0" />
                    </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="Delete">
                    <HBox.margin>
                        <Insets top="8.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
