<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GuestDashboardController">
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="150" spacing="25" style="-fx-background-color: #6B7280;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>
            <ImageView fitHeight="287.0" fitWidth="232.0" preserveRatio="true">
                <image>
                    <Image url="@/Images/Logo_white.png" />
                </image>
            </ImageView>
            <Button fx:id="home" onAction="#handleHome" prefHeight="21.0" prefWidth="46.0">
                <graphic>
                    <ImageView fitHeight="41.0" fitWidth="29.0" preserveRatio="true">
                        <image>
                            <Image url="@../Images/home.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="newFiles" onAction="#handleNewFiles" prefHeight="36.0" prefWidth="48.0">
                <graphic>
                    <ImageView fitHeight="27.0" fitWidth="31.0" preserveRatio="true">
                        <image>
                            <Image url="@/Images/files.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <VBox VBox.vgrow="ALWAYS">
            <children>
                  <HBox alignment="CENTER" prefHeight="1.0" prefWidth="157.0" spacing="10">
                      <Button fx:id="login" onAction="#handleLogin" text="Login" />
                      <Button fx:id="register" onAction="#handleSignUp" text="Signup" />
                  </HBox>
            </children></VBox>
        </VBox>
    </left>
    <center>
        <VBox fx:id="centerPane" alignment="CENTER" VBox.vgrow="ALWAYS" />
    </center>

</BorderPane>
