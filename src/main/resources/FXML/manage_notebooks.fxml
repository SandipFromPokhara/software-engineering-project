<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageNotebookController">
   <top>
      <Label fx:id="manageTitle" BorderPane.alignment="CENTER">
         <font>
            <Font name="SansSerif Bold" size="18.0" />
         </font>
         <BorderPane.margin>
            <Insets top="14.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <ListView fx:id="notebookListView" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="4.0" left="20.0" right="20.0" top="10.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
         </padding>
      </ListView>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="openBtn" defaultButton="true" mnemonicParsing="false" onAction="#handleOpen" style="-fx-cursor: hand;">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="renameBtn" mnemonicParsing="false" onAction="#handleRename" style="-fx-cursor: hand;">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#handleDelete" style="-fx-cursor: hand;">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="closeBtn" mnemonicParsing="false" onAction="#handleClose" style="-fx-cursor: hand;">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets left="4.0" right="4.0" top="2.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="4.0" left="6.0" right="6.0" top="2.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>