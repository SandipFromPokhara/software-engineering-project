<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="dialogPane"
      prefWidth="290.0"
      spacing="10.0"
      style="-fx-background-color: #f0f9fa;
             -fx-border-color: #266973;
             -fx-border-width: 1.5;
             -fx-border-radius: 12;
             -fx-background-radius: 12;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LanguageDialogController">
    <padding>
        <Insets top="18.0" bottom="18.0" left="18.0" right="18.0" />
    </padding>
    <children>

        <Label fx:id="titleLabel" text="Select Language" textFill="#266973">
            <font><Font name="Times New Roman Bold" size="16.0" /></font>
        </Label>

        <Separator style="-fx-background-color: #b0d8de;" />

        <VBox fx:id="languagePane" spacing="6.0">
            <padding><Insets top="4.0" bottom="4.0" /></padding>
        </VBox>

        <Separator style="-fx-background-color: #b0d8de;" />

        <Button fx:id="confirmButton" text="Apply"
                maxWidth="Infinity"
                prefHeight="34.0"
                onAction="#handleConfirm"
                style="-fx-background-color: #266973; -fx-text-fill: white;
                     -fx-font-weight: bold; -fx-background-radius: 7;
                     -fx-cursor: hand; -fx-font-size: 13px;">
            <font><Font name="Times New Roman Bold" size="13.0" /></font>
        </Button>

    </children>
</VBox>