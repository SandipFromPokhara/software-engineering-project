<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #EAF7F7;" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <left>
        <StackPane prefHeight="400.0" prefWidth="241.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="283.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../Images/NoteVault.png" />
                    </image>
                </ImageView>
                <Label fx:id="privacyLabel" alignment="CENTER" text="" textAlignment="CENTER" textFill="WHITE" wrapText="true" StackPane.alignment="CENTER">
                    <StackPane.margin>
                        <Insets left="15.0" right="15.0" top="40.0" />
                    </StackPane.margin>
                    <font>
                        <Font name="System Regular" size="16.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
    </left>
    <center>
        <AnchorPane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: #ebf4f5;" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="loginWelcome" alignment="CENTER" contentDisplay="CENTER" layoutX="75.0" layoutY="31.0" prefHeight="53.0" prefWidth="189.0" text="Welcome" textAlignment="CENTER" textFill="#297883" textOverrun="CLIP">
                    <font>
                        <Font name="System Italic" size="30.0" />
                    </font>
                </Label>
                <Label fx:id="loginNote" alignment="CENTER" layoutX="49.0" layoutY="74.0" prefHeight="35.0" prefWidth="237.0" text="Please Login to access your notes." textFill="#307494">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </Label>
                <VBox layoutX="54.0" layoutY="132.0" prefHeight="128.0" prefWidth="220.0" spacing="20.0" AnchorPane.topAnchor="136.0">
                    <children>
                        <TextField fx:id="usernameField" alignment="CENTER" prefHeight="30.0" prefWidth="150.0" promptText="Username" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 6 10 6 10; -fx-border-color: rgba(37,105,115,0.18); -fx-background-color: white;">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </TextField>
                        <PasswordField fx:id="passwordField" alignment="CENTER" prefHeight="30.0" prefWidth="150.0" promptText="Password" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 6 10 6 10; -fx-border-color: rgba(37,105,115,0.18); -fx-background-color: white;">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </PasswordField>
                        <Button fx:id="loginButton" alignment="CENTER" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #266973; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;" text="Login" textAlignment="CENTER">
                            <font>
                                <Font name="Times New Roman Bold" size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets left="24.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </VBox>
                <Label fx:id="statusLabel"
                       alignment="CENTER"
                       contentDisplay="CENTER"
                       AnchorPane.leftAnchor="0.0"
                       AnchorPane.rightAnchor="0.0"
                       AnchorPane.bottomAnchor="74.0">
                    <font>
                        <Font size="12" />
                    </font>
                </Label>
                <HBox alignment="CENTER" layoutX="52.0" layoutY="339.0" spacing="2.0" AnchorPane.leftAnchor="52.0" AnchorPane.rightAnchor="53.0" AnchorPane.topAnchor="339.0">
                    <children>
                        <Label fx:id="loginNoAccount" text="Don't have an account?" textFill="#455a64">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                        <Hyperlink fx:id="signupLink" onAction="#handleSignUp" style="-fx-text-fill: #266973; -fx-font-weight: bold;" text="Sign up">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Hyperlink>
                    </children>
                </HBox>
                <Button fx:id="backButton" alignment="CENTER" contentDisplay="CENTER" layoutX="116.0" layoutY="364.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="26.0" prefWidth="106.0" style="-fx-cursor: hand; -fx-background-color: transparent; -fx-font-weight: bold;" text="← Back" textFill="#324326" AnchorPane.bottomAnchor="11.0" AnchorPane.leftAnchor="116.0" AnchorPane.rightAnchor="97.0">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
