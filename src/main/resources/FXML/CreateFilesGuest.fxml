<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CreateFilesGuestController">

    <!-- Title -->
    <Label text="Title" AnchorPane.leftAnchor="10" AnchorPane.topAnchor="10" />
    <TextField fx:id="titleBox" promptText="Enter your text title" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="30" />

    <!-- Content -->
    <Label text="Content" AnchorPane.leftAnchor="10" AnchorPane.topAnchor="65" />
    <TextArea fx:id="contentBox" promptText="Write your content here" AnchorPane.bottomAnchor="60" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="90" /> <!-- leave space for annotation -->

    <!-- Annotation row -->
    <Label prefHeight="30" text="Annotation:" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" />

    <TextField fx:id="annotationBox" prefHeight="30" promptText="Enter annotation" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="90" AnchorPane.rightAnchor="100" />

    <!-- Cancel button -->
    <Button fx:id="cancelButton" onAction="#handleCancel" prefHeight="30" prefWidth="80" text="Cancel" AnchorPane.bottomAnchor="10" AnchorPane.rightAnchor="10" />

</AnchorPane>
