<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GuestDashboardController">
   <top>
      <HBox fx:id="topBar" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #1A1A1A;" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane prefHeight="50.0" prefWidth="114.0">
               <children>
                  <ImageView fitHeight="50.0" fitWidth="164.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Images/Logo_white.png" />
                     </image>
                  </ImageView>
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </top>
   <left>
      <HBox prefHeight="350.0" prefWidth="150.0" style="-fx-background-color: #6B7280;" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane prefHeight="350.0" prefWidth="154.0">
               <children>
                  <Button fx:id="newFiles" layoutX="48.0" layoutY="68.0" mnemonicParsing="false" onAction="#handleNewFiles" prefHeight="39.0" prefWidth="47.0">
                     <graphic>
                        <ImageView fitHeight="23.0" fitWidth="31.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../Images/files.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="home" alignment="CENTER" layoutX="48.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleHome" prefHeight="41.0" prefWidth="46.0">
                     <graphic>
                        <ImageView fitHeight="23.0" fitWidth="31.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../Images/home.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="login" alignment="BOTTOM_LEFT" layoutX="10.0" layoutY="118.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="25.0" prefWidth="59.0" text="Login" />
                  <Button fx:id="register" layoutX="77.0" layoutY="118.0" mnemonicParsing="false" onAction="#handleRegister" text="Register" />
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </left>
   <center>
      <VBox  BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
            <VBox fx:id="centerPane" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </center>
</BorderPane>
