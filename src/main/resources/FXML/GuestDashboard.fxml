<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GuestDashboardController">
    <left>
        <VBox prefWidth="150" spacing="25" alignment="TOP_CENTER" style="-fx-background-color: #6B7280;" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <ImageView fitHeight="80" preserveRatio="true">
                <image>
                    <Image url="@../Images/Logo_white.png"/>
                </image>
            </ImageView>
            <Button fx:id="home"  onAction="#handleHome">
                <graphic>
                    <ImageView fitHeight="24" preserveRatio="true">
                        <image>
                            <Image url="@../Images/home.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="newFiles" onAction="#handleNewFiles">
                <graphic>
                    <ImageView fitHeight="24" preserveRatio="true">
                        <image>
                            <Image url="@../Images/files.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <VBox VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="login" text="Login" onAction="#handleLogin"/>
                <Button fx:id="register" text="Signup" onAction="#handleSignUp"/>
            </HBox>
        </VBox>
    </left>
    <center>
        <VBox fx:id="centerPane" alignment="CENTER" VBox.vgrow="ALWAYS"/>
    </center>

</BorderPane>
