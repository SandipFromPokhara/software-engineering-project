<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="530.0" prefWidth="670.0" style="-fx-background-color: #EAF7F7;" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignUpController">
    <stylesheets>
        <URL value="@/css/signup.css" />
    </stylesheets>

    <left>
        <StackPane prefHeight="530.0" prefWidth="320.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="530.0" fitWidth="320.0" preserveRatio="false" smooth="true">
                    <image>
                        <Image url="@../Images/NoteVault.png" />
                    </image>
                </ImageView>
                <Label fx:id="privacyLabel" alignment="CENTER" textAlignment="CENTER"
                       textFill="WHITE" wrapText="true"
                       StackPane.alignment="CENTER">
                    <StackPane.margin>
                        <Insets left="20.0" right="20.0" top="40.0" />
                    </StackPane.margin>
                    <font>
                        <Font name="System Regular" size="18.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
    </left>

    <center>
        <AnchorPane prefHeight="530.0" prefWidth="300.0" style="-fx-background-color: #ebf4f5;" BorderPane.alignment="CENTER">
            <children>

            <VBox alignment="CENTER" layoutX="61.0" layoutY="14.0" prefHeight="60.0" prefWidth="204.0" AnchorPane.topAnchor="14.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <children>
   
                       <Label fx:id="createAccount" alignment="CENTER" prefHeight="32.0" prefWidth="200.0" textFill="#297883">
                           <font>
                               <Font  size="22.0" />
                           </font>
                       </Label>
   
                       <Label fx:id="joinAccount" textFill="#307494">
                           <font>
                               <Font  size="12.0" />
                           </font>
                       </Label>
               </children>
            </VBox>

                <VBox alignment="TOP_CENTER" layoutX="55.0" layoutY="79.0" prefWidth="220.0" spacing="4.0"
                      AnchorPane.topAnchor="85.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="10.0">

                    <padding>
                        <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                    </padding>

                    <!-- First name -->
                    <Label fx:id="firstNameLabel" text="First Name" maxWidth="220" textFill="#455A64" />
                    <TextField fx:id="firstNameField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></TextField>

                    <!-- Last name -->
                    <Label fx:id="lastNameLabel" text="Last Name" maxWidth="220" textFill="#455A64" />
                    <TextField fx:id="lastNameField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></TextField>

                    <!-- Username -->
                    <Label fx:id="usernameLabel" text="Username" maxWidth="220" textFill="#455A64" />
                    <TextField fx:id="usernameField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></TextField>

                    <!-- Email -->
                    <Label fx:id="emailLabel" text="Email" maxWidth="220" textFill="#455A64" />
                    <TextField fx:id="emailField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></TextField>

                    <!-- Password -->
                    <Label fx:id="passwordLabel" text="Password" maxWidth="220" textFill="#455A64" />
                    <PasswordField fx:id="passwordField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></PasswordField>
                    <ProgressBar fx:id="passwordStrengthBar" maxWidth="220" prefHeight="12.0" prefWidth="200.0" visible="false" />
                    <Label fx:id="passwordStrengthLabel" prefHeight="10.0">
                  <font>
                     <Font size="10.0" />
                  </font></Label>

                    <!-- Confirm password -->
                    <Label fx:id="confirmPasswordLabel" text="Confirm Password" maxWidth="220" textFill="#455A64" />
                    <PasswordField fx:id="confirmPasswordField" maxWidth="220">
                  <font>
                     <Font size="12.0" />
                  </font></PasswordField>

                    <Button fx:id="signUpButton" maxWidth="140" prefHeight="30" prefWidth="107.0"
                            style="-fx-background-color: #2c5f77; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </Button>

                    <Label fx:id="messageLabel" alignment="CENTER" maxWidth="240.0" textAlignment="CENTER" textFill="#d32f2f" visible="false" wrapText="true">
                        <VBox.margin>
                            <Insets top="3.0" bottom="1.0" />
                        </VBox.margin>
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>

                    <HBox alignment="CENTER" spacing="6.0">
                        <children>
                            <Label fx:id="haveAccount" textFill="#455A64">
                                <font>
                                    <Font size="11" />
                                </font>
                            </Label>
                            <Hyperlink fx:id="loginLink" onAction="#onLogin" style="-fx-text-fill: #266973; -fx-font-weight: bold; -fx-font-size: 11;" />
                        </children>
                    </HBox>
                </VBox>

                <Button fx:id="backButton" layoutX="41.0" layoutY="30.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="28.0" prefWidth="29.0" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <SVGPath content="M12 2 L4 10 L12 18 L10 20 L0 10 L10 0 Z" styleClass="back-icon" />
                    </graphic>
                </Button>

            </children>
        </AnchorPane>
    </center>
</BorderPane>
