<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="600.0" minWidth="700.0" prefHeight="700.0" prefWidth="800.0" stylesheets="@../css/createNote.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditNoteController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem fx:id="undoMenuItem" mnemonicParsing="false" onAction="#handleUndo" text="Undo" accelerator="Ctrl+Z" />
                        <MenuItem fx:id="redoMenuItem" mnemonicParsing="false" onAction="#handleRedo" text="Redo" accelerator="Ctrl+Y" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <AnchorPane>
            <children>
                <VBox spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <VBox spacing="5.0">
                        <Label fx:id="title" text="Title">
                            <font>
                                <Font name="System Bold" size="14" />
                            </font>
                        </Label>
                        <TextField fx:id="titleBox" promptText="Enter your text title">
                            <font>
                                <Font size="14" />
                            </font>
                        </TextField>
                        <VBox.margin>
                            <Insets left="25.0" right="25.0" top="10.0" />
                        </VBox.margin>
                    </VBox>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <Label fx:id="content" text="Content">
                            <font>
                                <Font name="System Bold" size="14" />
                            </font>
                        </Label>
                        <!-- Content Editor with Toolbar -->
                        <VBox spacing="0.0" styleClass="editor-container" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Professional Toolbar -->
                                <HBox alignment="CENTER_LEFT" spacing="2.0" styleClass="editor-toolbar">
                                    <children>
                                        <Button fx:id="boldButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn" text="B">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="italicButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, italic-btn" text="I">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="underlineButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, underline-btn" text="U">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                                            <padding>
                                                <Insets bottom="4.0" top="4.0" />
                                            </padding>
                                        </Separator>
                                        <Button fx:id="textColorButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, color-btn" text="A">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Button>
                                        <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                                            <padding>
                                                <Insets bottom="4.0" top="4.0" />
                                            </padding>
                                        </Separator>
                                        <Button fx:id="bulletListButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn" text="•">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="numberedListButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn" text="1.">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Button>
                                        <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                                            <padding>
                                                <Insets bottom="4.0" top="4.0" />
                                            </padding>
                                        </Separator>
                                        <Button fx:id="alignLeftButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, align-left" text="⚊">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="alignCenterButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, align-center" text="☰">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="alignRightButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn, align-right" text="⚊">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                                            <padding>
                                                <Insets bottom="4.0" top="4.0" />
                                            </padding>
                                        </Separator>
                                        <Button fx:id="headingUpButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn" text="H+">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="headingDownButton" mnemonicParsing="false" onAction="#handleToolbarClick" styleClass="toolbar-btn" text="H-">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                    <padding>
                                        <Insets bottom="4.0" left="8.0" right="8.0" top="4.0" />
                                    </padding>
                                </HBox>

                                <!-- Text Area -->
                                <TextArea fx:id="contentBox" prefHeight="480.0" promptText="Write your content here" styleClass="editor-textarea" wrapText="true" VBox.vgrow="ALWAYS">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextArea>
                            </children>
                        </VBox>
                        <VBox.margin>
                            <Insets left="25.0" right="25.0" top="5.0" />
                        </VBox.margin>
                    </VBox>
                    <VBox spacing="5.0">
                        <Label fx:id="annotation" text="Annotation">
                            <font>
                                <Font name="System Bold" size="14" />
                            </font>
                        </Label>
                        <TextArea fx:id="annotationBox" prefHeight="50.0" promptText="Add annotations here..." wrapText="true">
                            <font>
                                <Font size="14" />
                            </font>
                        </TextArea>
                        <VBox.margin>
                            <Insets left="25.0" right="25.0" />
                        </VBox.margin>
                    </VBox>
                    <HBox spacing="5.0">
                        <children>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@/Images/tags.png" />
                                </image>
                            </ImageView>
                            <Label text="Tags">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label alignment="CENTER" opacity="0.64" style="-fx-background-color: lightgray; -fx-background-radius: 50%; -fx-min-height: 16px; -fx-min-width: 16px; -fx-cursor: hand;" text="?">
                                <tooltip>
                                    <Tooltip fx:id="tagTooltip" text="Tags are kewords to organize your notes">
                                        <font>
                                            <Font name="System Italic" size="10.0" />
                                        </font>
                                    </Tooltip>
                                </tooltip>
                                <HBox.margin>
                                    <Insets top="1.0" />
                                </HBox.margin>
                            </Label>
                        </children>
                        <VBox.margin>
                            <Insets left="25.0" />
                        </VBox.margin>
                    </HBox>
                    <FlowPane fx:id="tagFlowpane" hgap="8.0" vgap="6.0">
                        <VBox.margin>
                            <Insets left="25.0" />
                        </VBox.margin>
                    </FlowPane>
                    <HBox spacing="5.0">
                        <children>
                            <ComboBox fx:id="tagComboBox" editable="true" prefWidth="150.0" promptText="Add/Select a tag..." />
                            <Button fx:id="addTagBtn" mnemonicParsing="false" onAction="#handleAddTag" text="Add tags" />
                        </children>
                        <VBox.margin>
                            <Insets left="25.0" />
                        </VBox.margin>
                    </HBox>
                    <HBox alignment="CENTER" spacing="50.0">
                        <Button fx:id="updateButton" onAction="#handleUpdate" prefWidth="100.0" text="Update">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="cancelButton" alignment="CENTER" contentDisplay="CENTER" onAction="#handleCancel" prefWidth="100.0" text="Cancel">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <VBox.margin>
                            <Insets bottom="10.0" left="25.0" right="25.0" top="3.0" />
                        </VBox.margin>
                    </HBox>
                </VBox>
            </children>
        </AnchorPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="" visible="false">
            <BorderPane.margin>
                <Insets bottom="10" left="20" right="20" />
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>