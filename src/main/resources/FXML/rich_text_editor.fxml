<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"  fx:controller="controller.RichTextEditorController"  spacing="5.0"  styleClass="editor-container">

    <children>
        <!-- Toolbar: B | I | U | • | 1. | H+ | H- -->
        <HBox alignment="CENTER_LEFT" spacing="2.0" styleClass="editor-toolbar">
            <children>
                <!-- Bold, Italic, Underline -->
                <Button fx:id="boldButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="B">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="italicButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="I">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </Button>
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="underlineButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="U">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

                <!-- Bullet / Numbered lists -->
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="bulletListButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="•">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="numberedListButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="1.">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

                <!-- Heading size controls -->
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="headingUpButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="H+">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                    <padding>
                        <Insets bottom="4.0" left="4.0" top="4.0" />
                    </padding>
                </Separator>
                <Button fx:id="headingDownButton" mnemonicParsing="false"
                        onAction="#handleToolbarClick"
                        styleClass="toolbar-btn" text="H-">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="4.0" left="8.0" right="8.0" top="4.0" />
            </padding>
        </HBox>

        <!-- InlineCssTextArea is created programmatically in RichTextEditorController.initialize() -->
        <VBox fx:id="editorWrapper" VBox.vgrow="ALWAYS" />

    </children>
</VBox>
